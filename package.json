{
  "name": "ember-launcher",
  "version": "1.4.2",
  "description": "Game launcher with automatic playtime tracking",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "dev:desktop": "electron .",
    "build:desktop": "electron-builder --win --publish never",
    "dev:website": "node apps/website/scripts/dev.js",
    "build:website": "node apps/website/scripts/build.js",
    "preview:website": "node apps/website/scripts/dev.js --dist",
    "test:website": "node apps/website/test/website.test.js"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "local.ember.launcher",
    "productName": "Ember Launcher",
    "files": [
      "main.js",
      "preload.js",
      "preload-updater.js",
      "welcome.js",
      "renderer/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Ember-Launcher-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "laggzilla16",
        "repo": "ember-universal-launcher"
      }
    ],
    "portable": {
      "artifactName": "Ember-Launcher-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
