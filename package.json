{
  "name": "ember-launcher",
  "version": "1.5.3",
  "description": "NUKRON — PC game launcher with automatic playtime tracking and optical-glass performance overlay",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "predist": "node build/prepare-installer.js",
    "dist": "electron-builder --win --publish never",
    "dev:desktop": "electron .",
    "prebuild:desktop": "node build/prepare-installer.js",
    "build:desktop": "electron-builder --win --publish never",
    "test:installer": "node test/installer.test.js",
    "dev:website": "node apps/website/scripts/dev.js",
    "build:website": "node apps/website/scripts/build.js",
    "preview:website": "node apps/website/scripts/dev.js --dist",
    "test:website": "node apps/website/test/website.test.js"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "local.ember.launcher",
    "productName": "NUKRON",
    "files": [
      "main.js",
      "preload.js",
      "preload-updater.js",
      "welcome.js",
      "renderer/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "NUKRON",
      "artifactName": "NUKRON-Setup-${version}.${ext}",
      "include": "build/installer.nsh",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "laggzilla16",
        "repo": "ember-universal-launcher"
      }
    ],
    "portable": {
      "artifactName": "NUKRON-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "driver.js": "1.11.0",
    "electron-updater": "^6.6.2"
  }
}
